# Slack app (OAuth & Permissions → Bot User OAuth Token; Basic Information → Signing Secret)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional; default is a Sonnet 4 snapshot
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GitHub PAT with `gist` scope — server-side only; never commit
GITHUB_TOKEN=ghp_...
# Secret gist ID (from gist URL) containing file ticket_users.json
GITHUB_GIST_ID=abc123...

# Local dev / some hosts
PORT=8000
